      "id": "be-tired",
      "group": "be",
      "title": "Fáradt vagyok",
      "base": "I am tired.",
      "meaning": "Fáradt vagyok.",
      "explanation": "A tired melléknévvel a be igét használjuk: I'm tired; I'm not tired; Are you tired? Nem mondjuk: I don't tired.",
      "examples": [
        "I am tired.",
        "I'm not tired.",
        "Are you tired?"
      ]
    },
    {
      "id": "be-home",
      "group": "be",
      "title": "Otthon vagyok",
      "base": "I am at home.",
      "meaning": "Otthon vagyok.",
      "explanation": "Az at home jelentése: otthon. Ugyanazt az am / am not / are you mintát használjuk.",
      "examples": [
        "I am at home.",
        "I'm not at home.",
        "Are you at home?"
      ]
    },
    {
      "id": "have-time",
      "group": "do",
      "title": "Van időm",
      "base": "I have time.",
      "meaning": "Van időm.",
      "explanation": "A „van időm” angolul have time: I have time; I don't have time; Do you have time? Nem mondjuk: I was have time; a múlt időt a következő leckében tanuljuk.",
      "examples": [
        "I have time.",
        "I don't have time.",
        "Do you have time?"
      ]
    },
    {
      "id": "know-answer",
      "group": "do",
      "title": "Tudom a választ",
      "base": "I know the answer.",
      "meaning": "Tudom a választ.",
      "explanation": "I know the answer; I don't know the answer; Do you know the answer? A know állapotot jelent, de nem be igével használjuk.",
      "examples": [
        "I know the answer.",
        "I don't know the answer.",
        "Do you know the answer?"
      ]
    },
    {
      "id": "need-help",
