{
  "id": "everyday-01",
  "title": "Öt mondat a mindennapokra",
  "patterns": [
    {"id":"be-tired","group":"be","title":"Fáradt vagyok","base":"I am tired.","meaning":"Fáradt vagyok.","explanation":"Az am az I után áll. Tagadáskor not követi, kérdésben az are kerül a you elé.","examples":["I am tired.","I'm not tired.","Are you tired?"]},
    {"id":"be-home","group":"be","title":"Otthon vagyok","base":"I am at home.","meaning":"Otthon vagyok.","explanation":"Az at home jelentése: otthon. Ugyanazt az am / am not / are you mintát használjuk.","examples":["I am at home.","I'm not at home.","Are you at home?"]},
    {"id":"have-time","group":"do","title":"Van időm","base":"I have time.","meaning":"Van időm.","explanation":"Egyszerű jelenben a have tagadásához don't, kérdéséhez do segédigét használunk.","examples":["I have time.","I don't have time.","Do you have time?"]},
    {"id":"know-answer","group":"do","title":"Tudom a választ","base":"I know the answer.","meaning":"Tudom a választ.","explanation":"A know tagadásakor don't know, kérdésben do you know a minta.","examples":["I know the answer.","I don't know the answer.","Do you know the answer?"]},
    {"id":"need-help","group":"do","title":"Segítségre van szükségem","base":"I need help.","meaning":"Segítségre van szükségem.","explanation":"A need igével is a don't / do you szerkezetet használjuk.","examples":["I need help.","I don't need help.","Do you need help?"]}
  ],
  "cards": [
